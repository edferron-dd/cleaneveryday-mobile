<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CleanEverydayMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CleanEverydayMobile.Views"
    Title="Clean Everyday">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Location"
        ContentTemplate="{DataTemplate views:LocationSelectionPage}"
        Route="LocationSelectionPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

</Shell>
