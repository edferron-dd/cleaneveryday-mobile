<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CleanEverydayMobile.Views.ChecklistPage"
             Title="Checklist">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <ActivityIndicator Grid.Row="0"
                           x:Name="LoadingIndicator"
                           IsRunning="True"
                           IsVisible="True"
                           Color="#512BD4"
                           HorizontalOptions="Center" />

        <Label x:Name="ErrorLabel"
               Grid.Row="0"
               TextColor="Red"
               IsVisible="False"
               HorizontalOptions="Center" />

        <CollectionView Grid.Row="1"
                        x:Name="ChecklistItemsView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Status}"
                                  CheckedChanged="OnItemCheckedChanged"
                                  AutomationId="{Binding Id}" />
                        <Label Grid.Column="1"
                               Text="{Binding Text}"
                               VerticalOptions="Center"
                               FontSize="16" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="NewItemEntry"
                   Grid.Column="0"
                   Placeholder="New checklist item..."
                   ReturnCommand="{Binding Source={x:Reference AddItemButton}, Path=Command}" />
            <Button x:Name="AddItemButton"
                    Grid.Column="1"
                    Text="Add"
                    Clicked="OnAddItemClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8" />
        </Grid>

    </Grid>
</ContentPage>
